# === Perfect JSON API — пример окружения ===
# Скопируйте в .env и замените все заглушки. Никаких реальных секретов в репозитории.

# --- Окружение ---
ENV=local
LOG_LEVEL=INFO
# text | json (json — для прод-сбора логов)
LOG_FORMAT=text

# --- Секреты (обязательны в production) ---
SECRET_KEY=change-me-secret-key
ADMIN_API_KEY=change-me-admin-key

# --- База данных ---
DATABASE_URL=sqlite+aiosqlite:///./data/perfect_json.db
# production: postgresql+asyncpg://perfectjson:password@postgres:5432/perfectjson

# --- Redis (опционально: распределённые лимиты и очереди задач) ---
# без REDIS_URL лимиты in-memory на процесс (предупреждение в production)
REDIS_URL=

# --- LLM (любой OpenAI-совместимый провайдер) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_RETRY_ENABLED=true
LLM_RETRY_DELAY_SECONDS=0.5

# --- Fallback-модель (опционально) ---
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# --- Лимиты и автопочинка ---
MAX_INPUT_CHARS=50000
MAX_FILE_MB=20
DEFAULT_MAX_REPAIRS=2

# --- Тарификация ---
CREDIT_BASE_COST=1
CREDIT_COST_PER_1K_INPUT_CHARS=0.5
CREDIT_COST_PER_1K_OUTPUT_TOKENS=2.0

# --- Биллинговый контур ---
HOLDS_ENABLED=true
MAX_COST_DEFAULT_CREDITS=120
IDEMPOTENCY_ENABLED=true
ADMIN_REQUIRE_IDEMPOTENCY=false
BALANCE_LOW_THRESHOLD=10

# --- Публичный бот 3.1: демо-трансформации отключены по умолчанию ---
TELEGRAM_DEMO_TRANSFORM_ENABLED=false
# ОПАСНО: разрешить трансформации публичному боту в production
ENABLE_DANGEROUS_PUBLIC_DEMO_TRANSFORM=false
# ОПАСНО: разрешить стартовые кредиты внутреннему ключу при публичном режиме
ALLOW_INTERNAL_DEMO_CREDITS=false

# --- Платежи 3.1: подтверждение цен и пороги зависших ---
TELEGRAM_STARS_PRICES_CONFIRMED=false
PAYMENT_PROCESSING_ALERT_MINUTES=15
PAYMENT_RECEIVED_ALERT_MINUTES=30
PAYMENT_CREATED_TTL_HOURS=24

# --- Холды 3.0: TTL, heartbeat, reaper ---
HOLDS_TTL_SECONDS=900
HOLD_HEARTBEAT_INTERVAL_SECONDS=120
RUN_HOLD_REAPER=true
HOLD_REAPER_INTERVAL_SECONDS=60

# --- Строгость лимитов в production (3.0) ---
WEB_CONCURRENCY=1
ALLOW_IN_MEMORY_RATE_LIMIT_IN_PROD=false

# --- Лимиты по умолчанию (0 = без лимита) ---
RATE_LIMIT_DEFAULT_RPM=60
RATE_LIMIT_DEFAULT_RPD=5000
DEFAULT_CONCURRENCY_LIMIT=5
DEFAULT_DAILY_SPEND_LIMIT=0
DEFAULT_MONTHLY_SPEND_LIMIT=0
DEFAULT_DAILY_INPUT_CHARS_LIMIT=0

# --- Наблюдаемость ---
ENABLE_METRICS=false
METRICS_KEY=

# --- OCR / STT (опционально) ---
OCR_ENABLED=false
OCR_LANG=eng+rus
STT_ENABLED=false
STT_PROVIDER=openai
STT_API_KEY=
STT_MODEL=whisper-1

# --- Качество ---
NORMALIZATION_DEFAULT=off
# Версия промптов (пусто = из кода, PROMPT_VERSION в ответах meta)
PROMPT_VERSION=
# Заголовок корреляции запросов
REQUEST_ID_HEADER=X-Request-ID
EVAL_DATASETS_DIR=app/eval/datasets
EVAL_REPORTS_DIR=eval/reports

# --- Безопасность файлов ---
MAX_PDF_PAGES=200
MAX_DOCX_PARAGRAPHS=5000
MAX_CSV_ROWS=10000
MAX_JSON_DEPTH=32
MAX_JSON_KEYS=50000
MAX_EXTRACTED_CHARS=200000
PDF_OCR_ENABLED=false
MALWARE_SCAN_ENABLED=false
CLAMAV_URL=

# --- Telegram-бот ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_DAILY_LIMIT=10
TELEGRAM_BOT_START_CREDITS=1000
TELEGRAM_PUBLIC_MODE=false
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_RATE_LIMIT_PER_MINUTE=20
TELEGRAM_RATE_LIMIT_PER_DAY=0

# --- CORS ---
CORS_ORIGINS=

# --- События и уведомления (P1) ---
ALERT_BALANCE_THRESHOLD=10
ALERT_ADMIN_TELEGRAM_IDS=
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=

# --- Асинхронные задачи и вебхуки (P1) ---
JOBS_ENABLED=false
JOB_INPUT_RETENTION_HOURS=24
BATCH_INLINE_LIMIT=5
BATCH_MAX_ITEMS=100
WEBHOOKS_ENABLED=false
WEBHOOK_MAX_RETRIES=5
WEBHOOK_TIMEOUT_SECONDS=10

# --- Self-serve (задел 2.x, см. docs/SELF_SERVE.md) ---
SELF_SERVE_ENABLED=false

# --- Платежи 3.0: ТОЛЬКО Telegram Stars ---
# (Stripe и прочие провайдеры удалены в 3.0; переменных больше нет)
PAYMENTS_ENABLED=false
TELEGRAM_STARS_ENABLED=false
# Пакеты: code:credits:stars (цены-плейсхолдеры, отредактируйте под себя)
TELEGRAM_STARS_PACKAGES=starter:500:99,pro:2000:199,growth:6000:899
TELEGRAM_STARS_MAX_PURCHASES_PER_DAY=10
TELEGRAM_STARS_MAX_INVOICES_PER_HOUR=5
# Опциональная оценка выручки: 1 Star ≈ USD (пусто = estimated флаг)
TELEGRAM_STARS_USD_PER_STAR=
CREDIT_PRICE_USD=0.01

# --- Экономическая аналитика ---
PROVIDER_COST_PER_1K_INPUT_TOKENS=0
PROVIDER_COST_PER_1K_OUTPUT_TOKENS=0
CHARS_PER_TOKEN_ESTIMATE=4

# --- Миграции и бэкапы ---
ALEMBIC_INI_PATH=alembic.ini
BACKUP_DIR=backups
